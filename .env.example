# ─── LifeOS environment variables ─────────────────────────────
# Copy this file to `.env` and fill in the values you need.

# Required for multi-user accounts (register / PIN login). Use any long random string.
# SESSION_SECRET="generate-a-long-random-string-here"

# PostgreSQL connection for accounts + cloud backup & multi-device sync.
# Examples: Supabase, Neon, Railway, or self-hosted Postgres.
# DATABASE_URL="postgresql://user:password@host:5432/lifeos?schema=public"

# Optional: secret for Apple Health shortcut / automation POST /api/health-sync
# Generate a long random string and use the same value in your iOS Shortcut.
# APPLE_HEALTH_SECRET="your-random-secret-here"

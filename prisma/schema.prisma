generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  pinHash   String
  createdAt DateTime @default(now())

  settings      UserSettings?
  projects      Project[]
  finance       FinanceEntry[]
  fitness       FitnessEntry[]
  diet          DietEntry[]
  gym           GymEntry[]
  hobbies       HobbyEntry[]
  subjects      Subject[]
  study         StudySession[]
  habits        HabitEntry[]
  conversations AIConversation[]
  weeklyReports WeeklyReport[]
  timeline      TimelineEvent[]
  trades        Trade[]
  standardMeals StandardMeal[]
}

model Project {
  id           Int         @id @default(autoincrement())
  accountId    Int
  title        String
  description  String
  notes        String
  tags         String
  category     String
  techStack    String
  projectType  String
  difficulty   String
  status       String
  githubUrl    String
  deployedUrl  String
  youtubeUrl   String
  docsUrl      String
  links        String
  files        String
  milestones   Milestone[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  account      Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model Milestone {
  id        String   @id @default(uuid())
  title     String
  completed Boolean  @default(false)
  dueDate   String?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
}

model FinanceEntry {
  id          Int      @id @default(autoincrement())
  accountId   Int
  amount      Float
  type        String
  category    String
  description String
  date        DateTime
  aiCategory  String?
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model FitnessEntry {
  id             Int      @id @default(autoincrement())
  accountId      Int
  date           DateTime
  steps          Int
  distance       Float
  caloriesBurned Int
  activeMinutes  Int
  notes          String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model DietEntry {
  id             Int      @id @default(autoincrement())
  accountId      Int
  date           DateTime
  mealType       String
  food           String
  calories       Int
  protein        Int
  carbs          Int
  fat            Int
  aiBreakdown    String
  micronutrients String?
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model StandardMeal {
  id             Int      @id @default(autoincrement())
  accountId      Int
  mealType       String
  name           String
  food           String
  calories       Int
  protein        Int
  carbs          Int
  fat            Int
  micronutrients String?
  createdAt      DateTime @default(now())
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model GymEntry {
  id           Int           @id @default(autoincrement())
  accountId    Int
  date         DateTime
  muscleGroup  String
  exercises    GymExercise[]
  isRestDay    Boolean       @default(false)
  aiSuggestion String?
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model GymExercise {
  id         Int      @id @default(autoincrement())
  name       String
  weight     Float
  sets       Int
  reps       Int
  gymEntry   GymEntry @relation(fields: [gymEntryId], references: [id], onDelete: Cascade)
  gymEntryId Int
}

model HobbyEntry {
  id        Int      @id @default(autoincrement())
  accountId Int
  name      String
  category  String
  timeSpent Int
  date      DateTime
  notes     String
  milestone String?
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model Subject {
  id               Int               @id @default(autoincrement())
  accountId        Int
  name             String
  instructor       String?
  semester         String?
  credits          Int?
  priority         String
  syllabusProgress Int               @default(0)
  notes            String?
  color            String
  createdAt        DateTime          @default(now())
  assignments      StudyAssignment[]
  account          Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model StudyAssignment {
  id        Int      @id @default(autoincrement())
  title     String
  type      String
  dueDate   DateTime
  completed Boolean  @default(false)
  score     String?
  notes     String?
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId Int
}

model StudySession {
  id            Int      @id @default(autoincrement())
  accountId     Int
  subject       String
  subjectId     Int?
  topic         String
  duration      Int
  date          DateTime
  notes         String
  quality       Int
  focusLevel    Int?
  studyMethod   String?
  breakDuration Int?
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model HabitEntry {
  id        Int      @id @default(autoincrement())
  accountId Int
  habitName String
  completed Boolean
  date      DateTime
  streak    Int
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model AIConversation {
  id        Int           @id @default(autoincrement())
  accountId Int
  title     String
  projectId Int?
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  account   Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model ChatMessage {
  id             Int            @id @default(autoincrement())
  role           String
  content        String
  timestamp      DateTime       @default(now())
  attachments    String?        // JSON string: Array<{ name: string, type: string, data: string }>
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId Int
}

model WeeklyReport {
  id                Int      @id @default(autoincrement())
  accountId         Int
  weekStart         DateTime
  weekEnd           DateTime
  summary           String
  productivityScore Float
  highlights        String
  aiInsights        String
  createdAt         DateTime @default(now())
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model TimelineEvent {
  id          Int      @id @default(autoincrement())
  accountId   Int
  title       String
  description String
  category    String
  date        DateTime
  icon        String?
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model UserSettings {
  id                    Int     @id @default(autoincrement())
  accountId             Int     @unique
  geminiApiKey          String
  githubToken           String
  githubUsername        String
  cloudBackupEnabled    Boolean @default(false)
  theme                 String  @default("dark")
  accentColor           String  @default("#00F5FF")
  dashboardWidgets      String
  name                  String
  avatar                String
  propFirmAccountsCount Int     @default(1)
  propFirmName          String?
  propFirmSize          Int?
  spotifyClientId       String?
  spotifyClientSecret   String?
  spotifyAccessToken    String?
  spotifyRefreshToken   String?
  spotifyExpiresAt      BigInt?
  summerBreakMode       Boolean @default(false)
  appleHealthEnabled    Boolean @default(false)
  account               Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Trade {
  id            Int      @id @default(autoincrement())
  accountId     Int
  ticker        String
  marketType    String
  side          String
  entryPrice    Float
  exitPrice     Float
  stopLoss      Float?
  takeProfit    Float?
  positionSize  Float
  riskAmount    Float
  pnl           Float
  pnlPercentage Float
  entryTime     DateTime
  exitTime      DateTime?
  status        String
  strategy      String
  setupType     String
  confidence    Int
  notes         String
  mistakes      String
  emotions      String
  screenshotUrl String?
  tags          String
  isPaperTrade  Boolean  @default(false)
  propFirm      String?
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}
